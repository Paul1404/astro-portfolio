---
const target = '/de/projects/stalwart/';

---
<!doctype html>
<html lang="de">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0;url=${target}`} />
        <link rel="canonical" href={new URL(target, Astro.site).href} />
        <meta name="robots" content="noindex" />
        <title>Projekt umgezogen</title>
    </head>
    <body>
        <p>Diese Seite ist umgezogen. <a href={target}>Weiter zum Projekt.</a></p>
    </body>
</html>
