---
const target = '/projects/stalwart/';

---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0;url=${target}`} />
        <link rel="canonical" href={new URL(target, Astro.site).href} />
        <meta name="robots" content="noindex" />
        <title>Project moved</title>
    </head>
    <body>
        <p>This page has moved. <a href={target}>Continue to the project.</a></p>
    </body>
</html>
