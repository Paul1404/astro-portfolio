---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const links = [
	{ label: t('nav.email'), href: 'mailto:contact@pd-portfolio.net', icon: 'lucide:mail' },
	{ label: t('nav.github'), href: 'https://github.com/Paul1404', icon: 'lucide:github' },
];
---

<footer class="mt-24 border-t border-line">
	<div
		class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6 py-10 text-sm text-subtle sm:flex-row"
	>
		<div class="flex flex-col items-center gap-1 sm:items-start">
			<p>&copy; {currentYear} Paul Dresch</p>
			<p>{t('footer.builtWith')}</p>
		</div>
		<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
			{
				links.map(({ label, href, icon }) => (
					<a
						href={href}
						target={href.startsWith('http') ? '_blank' : undefined}
						rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
						class="inline-flex min-h-11 items-center gap-1.5 transition-colors hover:text-ink"
					>
						<Icon name={icon} class="h-4 w-4" />
						{label}
					</a>
				))
			}
			<a
				href={`${localizePath('/privacy-policy/', lang)}#impressum`}
				class="inline-flex min-h-11 items-center transition-colors hover:text-ink"
			>
				{t('footer.legal')}
			</a>
			<div data-analytics-settings-slot class="rr-block">
				<a data-analytics-settings-fallback href={localizePath('/privacy-policy/', lang)} class="inline-flex min-h-11 items-center transition-colors hover:text-ink">{t('footer.analytics')}</a>
			</div>
		</div>
	</div>
</footer>

<script>
	// Keep the shared consent loader unchanged; only its placement is site-specific.
	const slot = document.querySelector<HTMLElement>('[data-analytics-settings-slot]');
	const fallback = slot?.querySelector<HTMLAnchorElement>('[data-analytics-settings-fallback]');
	const requestedKey = 'portfolio-open-analytics';
	fallback?.addEventListener('click', (event) => {
		if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		event.preventDefault();
		// Query/hash URLs intentionally exclude analytics. Open settings on the
		// plain privacy page instead, without weakening the shared route gate.
		try { sessionStorage.setItem(requestedKey, '1'); } catch { /* Navigation still works. */ }
		if (new URL(fallback.href).pathname === location.pathname && !location.search) {
			// Removing only a fragment is otherwise a same-document navigation,
			// which would leave the intentionally skipped consent loader dormant.
			history.replaceState(history.state, '', fallback.href);
			location.reload();
		} else {
			location.assign(fallback.href);
		}
	});
	const placeSettings = () => {
		const consent = document.getElementById('site-analytics-consent');
		if (!slot || !consent) return false;
		fallback?.remove();
		slot.append(consent);
		const settings = consent.querySelector<HTMLButtonElement>('[data-settings]');
		if (settings) {
			// Closing the initial prompt must not scroll the page to the footer.
			const focus = settings.focus.bind(settings);
			settings.focus = (options) => focus({ ...options, preventScroll: true });
			try {
				if (sessionStorage.getItem(requestedKey)) {
					sessionStorage.removeItem(requestedKey);
					if (consent.querySelector('section')?.hidden) settings.click();
				}
			} catch { /* The regular footer control remains available. */ }
		}
		return true;
	};
	if (slot && !placeSettings()) {
		const observer = new MutationObserver(() => {
			if (placeSettings()) observer.disconnect();
		});
		observer.observe(document.body, { childList: true });
	}
</script>

<style is:global>
	footer #site-analytics-consent [data-settings] {
		position: static;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-subtle);
		font: inherit;
		text-decoration: none;
	}
	footer #site-analytics-consent [data-settings]:hover {
		color: var(--color-ink);
	}
</style>
