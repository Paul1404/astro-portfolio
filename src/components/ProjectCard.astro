---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { slugOf, type Project } from '../lib/projects';
import { projectImages } from '../lib/project-images';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

interface Props { project: Project; }
const { project } = Astro.props;
const { title, description, stack, repoUrl, liveUrl, status, screenshot } = project.data;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localizePath(`/projects/${slugOf(project)}/`, lang);
const statusLabel = { wip: t('status.wip'), archived: t('status.archived') };
---

<article class:list={['project-entry border-t border-line pt-8', screenshot && 'grid items-center gap-6 lg:grid-cols-[1.5fr_1fr] lg:gap-10']}>
	{screenshot && (
		<figure class="min-w-0">
			<a href={href} class="block overflow-hidden rounded-lg border border-line bg-elevated transition-colors hover:border-brand">
				<Image src={projectImages[screenshot.image]} alt={screenshot.alt} widths={[640, 960, 1600]} sizes="(min-width: 1152px) 650px, (min-width: 1024px) 58vw, calc(100vw - 48px)" class="h-auto w-full" loading="lazy" />
			</a>
			<figcaption class="mt-2 text-xs text-subtle">{t('project.screenshotCaption')}</figcaption>
		</figure>
	)}
	<div class:list={['min-w-0', !screenshot && 'max-w-3xl']}>
		{status && <p class="mb-2 text-sm text-subtle">{statusLabel[status]}</p>}
		<h3 class="text-2xl font-semibold"><a href={href} class="decoration-brand underline-offset-4 hover:underline">{title}</a></h3>
		<p class="mt-3 text-base leading-relaxed text-muted">{description}</p>
		{stack.length > 0 && <p class="mt-4 font-mono text-xs leading-relaxed text-subtle">{stack.join(', ')}</p>}
		<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
			<a href={href} class="font-medium text-brand underline-offset-4 hover:underline">{t('project.details')}</a>
			{repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-muted hover:text-ink"><Icon name="lucide:github" class="h-4 w-4" />{t('project.code')}</a>}
			{liveUrl && <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-muted hover:text-ink"><Icon name="lucide:external-link" class="h-4 w-4" />{t('project.live')}</a>}
		</div>
	</div>
</article>
