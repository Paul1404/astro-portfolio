flowchart TB
  accTitle: Persistent data on Vertex
  accDescr: Applications use databases and files on Longhorn volumes, and some use S3-compatible Garage buckets. Garage data also resides on Longhorn. Longhorn keeps three volume replicas on cluster nodes.
  Apps["Applications"]:::workload
  DB["Databases + files"]:::workload
  Obj["Garage buckets<br/>separate application credentials"]:::storage
  Vol["Longhorn volumes"]:::storage
  subgraph copies["VOLUME REPLICAS / THREE COPIES"]
    A[("Replica A")]:::copy
    B[("Replica B")]:::copy
    C[("Replica C")]:::copy
  end
  Apps --> DB --> Vol
  Apps --> Obj --> Vol
  Vol --> A
  Vol --> B
  Vol --> C
  classDef workload fill:#ffffff,stroke:#94a3b8,color:#0f172a,stroke-width:1.5px
  classDef storage fill:#dcfce7,stroke:#86b99e,color:#14532d,stroke-width:1.5px
  classDef copy fill:#eef2ff,stroke:#a5b4fc,color:#3730a3,stroke-width:1.5px
