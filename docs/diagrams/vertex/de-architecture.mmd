flowchart TB
  accTitle: Datenverkehr und Plattformarchitektur von Vertex
  accDescr: Besucher erreichen das Traefik-Gateway direkt über Route 53 oder bei bestehenden Websites über CloudFront. HTTPRoutes leiten zu isolierten Anwendungsdiensten. Rancher Fleet gleicht den Sollzustand ab; cert-manager und ExternalDNS verwalten ausgewählte Zertifikate und DNS-Einträge. Longhorn stellt replizierten Speicher bereit, Garage S3-kompatible Buckets.
  Visitor([Besucher]):::person
  subgraph edge["ÖFFENTLICHER ZUGRIFF"]
    DNS["Route 53<br/>DNS mit Health Checks"]:::cloud
    CDN["CloudFront<br/>bestehende Websites"]:::cloud
  end
  subgraph cluster["VERTEX / VIER RKE2-KNOTEN"]
    GW["Traefik Gateway<br/>TLS + HTTPRoutes"]:::gateway
    Apps["App-Namespaces<br/>Services + Workloads"]:::workload
    Store["Longhorn<br/>replizierte Volumes"]:::storage
    Garage["Garage<br/>private Objekt-Buckets"]:::storage
    Fleet["Rancher Fleet<br/>Sollzustand abgleichen"]:::control
    Cert["cert-manager + ExternalDNS<br/>Zertifikate und DNS-Auswahl"]:::control
  end
  Git["Privates Git-Repository<br/>Plattform + Anwendungen"]:::source
  Visitor --> DNS
  Visitor --> CDN --> GW
  DNS --> GW --> Apps
  Git --> Fleet -.-> Apps
  Cert -.-> GW
  Apps --> Store
  Apps --> Garage --> Store
  classDef person fill:#e0e7ff,stroke:#818cf8,color:#312e81,stroke-width:1.5px
  classDef cloud fill:#eff6ff,stroke:#93c5fd,color:#1e3a5f,stroke-width:1.5px
  classDef gateway fill:#3730a3,stroke:#312e81,color:#ffffff,stroke-width:2px
  classDef workload fill:#ffffff,stroke:#94a3b8,color:#0f172a,stroke-width:1.5px
  classDef storage fill:#dcfce7,stroke:#86b99e,color:#14532d,stroke-width:1.5px
  classDef control fill:#eef2ff,stroke:#a5b4fc,color:#3730a3,stroke-width:1.5px
  classDef source fill:#fff7ed,stroke:#fdba74,color:#7c2d12,stroke-width:1.5px
